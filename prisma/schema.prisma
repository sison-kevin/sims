generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id     String
  action      String
  description String
  timestamp   DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audit_user")

  @@index([timestamp], map: "idx_audit_logs_timestamp")
}

model products {
  id              String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String
  sku             String            @unique
  barcode         String            @unique
  category        String
  price           Decimal           @db.Decimal(10, 2)
  cost_price      Decimal           @db.Decimal(10, 2)
  stock_quantity  Int
  reorder_level   Int
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  sale_items      sale_items[]
  stock_movements stock_movements[]
}

model sale_items {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sale_id    String
  product_id String
  quantity   Int
  unit_price Decimal  @db.Decimal(10, 2)
  line_total Decimal  @db.Decimal(10, 2)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saleitem_product")
  sales      sales    @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saleitem_sale")
}

model sales {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  sale_number   String       @unique
  customer_name String
  subtotal      Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  user_id       String
  sale_items    sale_items[]
  users         users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sale_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  product_id    String
  user_id       String
  type          String
  quantity      Int
  reason        String
  balance_after Int
  timestamp     DateTime @default(now()) @db.Timestamptz(6)
  products      products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stock_product")
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_stock_user")

  @@index([product_id, timestamp], map: "idx_stock_movements_product_timestamp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id              String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  name            String
  email           String            @unique
  role            String
  password_hash   String
  avatar_url      String?           @db.Text
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  audit_logs      audit_logs[]
  sales           sales[]
  stock_movements stock_movements[]
}

model workspace_settings {
  id              String   @id @default("singleton")
  profile         Json
  company         Json
  security        Json
  notifications   Json
  inventory_rules Json
  appearance      Json
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
}
